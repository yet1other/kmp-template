# Identifiers come from the project files, so scripts/rename.sh is the only place that changes them.
root = File.expand_path("..", __dir__)
base_package = File.read(File.join(root, "gradle.properties"))[/^app\.basePackage=(.+)$/, 1].strip
bundle_id = File.read(File.join(root, "app/iosApp/Configuration/Config.xcconfig"))[/^\s*PRODUCT_BUNDLE_IDENTIFIER\s*=\s*(\S+)/, 1]

package_name(base_package)
app_identifier(bundle_id)
