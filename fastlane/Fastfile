default_platform(:android)
require "fileutils"

ROOT = File.expand_path("..", __dir__)
XCCONFIG = File.join(ROOT, "app/iosApp/Configuration/Config.xcconfig")
XCODEPROJ = "app/iosApp/iosApp.xcodeproj"

# ---------------------------------------------------------------------------
# Project identifiers: read from the project files (scripts/rename.sh changes them there).
# ---------------------------------------------------------------------------
def gradle_property(name)
  value = File.read(File.join(ROOT, "gradle.properties"))[/^#{Regexp.escape(name)}=(.+)$/, 1]
  value ? value.strip : UI.user_error!("#{name} is missing from gradle.properties")
end

def xcconfig_value(name)
  value = File.read(XCCONFIG)[/^\s*#{Regexp.escape(name)}\s*=\s*([^\s\/]*)/, 1]
  value.nil? ? UI.user_error!("#{name} is missing from Config.xcconfig") : value
end

def project_name
  File.read(File.join(ROOT, "settings.gradle.kts"))[/rootProject\.name\s*=\s*"([^"]+)"/, 1]
end

def android_package = gradle_property("app.basePackage")
def ios_bundle_id = xcconfig_value("PRODUCT_BUNDLE_IDENTIFIER")
def ios_marketing_version = xcconfig_value("MARKETING_VERSION")

# The Apple team: IOS_TEAM_ID in CI, otherwise TEAM_ID in Config.xcconfig.
def ios_team_id
  team = ENV["IOS_TEAM_ID"].to_s.empty? ? xcconfig_value("TEAM_ID") : ENV["IOS_TEAM_ID"]
  team.empty? ? UI.user_error!("Set IOS_TEAM_ID or TEAM_ID in Config.xcconfig") : team
end

def version_name
  ENV["APP_VERSION_NAME"] or UI.user_error!("APP_VERSION_NAME env is not set")
end

def version_code
  ENV["APP_VERSION_CODE"] or UI.user_error!("APP_VERSION_CODE env is not set")
end

def require_env(*names)
  names.each { |name| UI.user_error!("#{name} env is not set") if ENV[name].to_s.empty? }
end

def app_store_api_key
  require_env("APP_STORE_CONNECT_KEY_ID", "APP_STORE_CONNECT_ISSUER_ID", "APP_STORE_CONNECT_KEY_CONTENT")
  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
    key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
    is_key_content_base64: true,
  )
end

def validate_ios_release_notes
  metadata_root = File.expand_path("metadata/ios", __dir__)
  missing = Dir[File.join(metadata_root, "*")].select { |locale_root|
    notes = File.join(locale_root, "release_notes.txt")
    !File.file?(notes) || File.read(notes, encoding: "UTF-8").strip.empty?
  }.map { |locale_root| File.basename(locale_root) }
  UI.user_error!("Missing iOS release notes for: #{missing.join(', ')}") unless missing.empty?
end

def stage_ios_release_notes
  source_root = File.expand_path("metadata/ios", __dir__)
  staging_root = File.join(ROOT, "build/store-metadata/ios")
  FileUtils.rm_rf(staging_root)
  Dir[File.join(source_root, "*")].each do |locale_root|
    release_notes = File.join(locale_root, "release_notes.txt")
    next unless File.file?(release_notes)

    destination = File.join(staging_root, File.basename(locale_root))
    FileUtils.mkdir_p(destination)
    FileUtils.cp(release_notes, File.join(destination, "release_notes.txt"))
  end
  staging_root
end

# ---------------------------------------------------------------------------
# Android — Google Play
# ---------------------------------------------------------------------------
platform :android do
  desc "Upload the localized Google Play listing without sending it for review"
  lane :publish_store_listing_draft do
    require_env("PLAY_STORE_JSON_KEY")
    upload_to_play_store(
      package_name: android_package,
      metadata_path: "fastlane/metadata/android",
      json_key_data: ENV["PLAY_STORE_JSON_KEY"],
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_changelogs: true,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      sync_image_upload: true,
      changes_not_sent_for_review: true,
      rescue_changes_not_sent_for_review: true,
    )
  end

  desc "Build a signed AAB + APK and upload the AAB to Google Play (internal track, draft)"
  lane :release do
    require_env("PLAY_STORE_JSON_KEY")
    properties = { "appVersionName" => version_name, "appVersionCode" => version_code }

    # AAB for Play (Play only accepts bundles for new uploads); APK for the GitHub Release.
    gradle(task: ":androidApp:bundleRelease", properties: properties)
    gradle(task: ":androidApp:assembleRelease", properties: properties)

    upload_to_play_store(
      package_name: android_package,
      track: "internal",
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      json_key_data: ENV["PLAY_STORE_JSON_KEY"],
      release_status: "draft",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end

# ---------------------------------------------------------------------------
# iOS — App Store Connect
# ---------------------------------------------------------------------------
platform :ios do
  desc "Upload the localized App Store listing without sending it for review"
  lane :publish_app_store_listing_draft do
    api_key = app_store_api_key
    validate_ios_release_notes
    upload_to_app_store(
      api_key: api_key,
      app_identifier: ios_bundle_id,
      app_version: ios_marketing_version,
      metadata_path: "fastlane/metadata/ios",
      screenshots_path: "fastlane/screenshots",
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: false,
      automatic_release: false,
      overwrite_screenshots: true,
      force: true,
      run_precheck_before_submit: false,
    )
  end

  desc "Upload only the localized What's New text"
  lane :publish_app_store_release_notes_draft do
    api_key = app_store_api_key
    validate_ios_release_notes
    upload_to_app_store(
      api_key: api_key,
      app_identifier: ios_bundle_id,
      app_version: ios_marketing_version,
      metadata_path: stage_ios_release_notes,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
    )
  end

  desc "Build a signed IPA and upload it to App Store Connect/TestFlight"
  lane :release do
    require_env("APP_VERSION_NAME", "APP_VERSION_CODE", "IOS_PROVISIONING_PROFILE_NAME")
    api_key = app_store_api_key
    profile_name = ENV["IOS_PROVISIONING_PROFILE_NAME"]
    team_id = ios_team_id
    bundle_id = ios_bundle_id
    name = project_name

    update_code_signing_settings(
      path: XCODEPROJ,
      targets: ["iosApp"],
      build_configurations: ["Release"],
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      bundle_identifier: bundle_id,
      profile_name: profile_name,
    )

    build_app(
      project: XCODEPROJ,
      scheme: "iosApp",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      output_directory: "build/ios",
      output_name: "#{name}.ipa",
      archive_path: "build/ios/#{name}.xcarchive",
      derived_data_path: "build/ios/DerivedData",
      include_symbols: true,
      xcargs: [
        "MARKETING_VERSION=#{version_name}",
        "CURRENT_PROJECT_VERSION=#{version_code}",
        "DEVELOPMENT_TEAM=#{team_id}",
        "TEAM_ID=#{team_id}",
        "PRODUCT_BUNDLE_IDENTIFIER=#{bundle_id}",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY='Apple Distribution'",
      ].join(" "),
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: { bundle_id => profile_name },
        uploadSymbols: true,
      },
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: bundle_id,
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end
end
